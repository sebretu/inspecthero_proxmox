"use client";

import { useEffect, useMemo, useState } from "react";

type ApiOk<T> = { ok: true; data: T };
type ApiErr = { ok: false; error: { code: string; message: string; meta?: any } };

type TaskRow = {
  id: string;
  project_id: string;
  plan_id: string;
  x_norm: number;
  y_norm: number;
  title: string;
  description: string | null;
  priority: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL";
  status: "OPEN" | "IN_PROGRESS" | "DONE_WAITING_APPROVAL" | "APPROVED" | "REJECTED";
  due_date: string | null;
  assigned_user_id: string | null;
  assigned_company_id: string | null;
  created_by: string;
  created_at: string;
  updated_at: string;
  rejection_reason: string | null;
};

type TaskPhoto = {
  id: string;
  task_id: string;
  url: string;
  caption: string | null;
  uploaded_by: string;
  created_at: string;
  storage_bucket: string;
  storage_path: string | null;
};

function isUuid(v: string) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v);
}

async function fileToBase64(file: File): Promise<string> {
  const buf = await file.arrayBuffer();
  const bytes = new Uint8Array(buf);
  let binary = "";
  for (let i = 0; i < bytes.byteLength; i++) binary += String.fromCharCode(bytes[i]);
  return btoa(binary);
}

export default function TaskDrawer({
  open,
  taskId,
  onClose,
  uploadedBy,
}: {
  open: boolean;
  taskId: string | null;
  onClose: () => void;
  uploadedBy: string; // DEV: UUID profilu
}) {
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [uploading, setUploading] = useState(false);

  const [task, setTask] = useState<TaskRow | null>(null);
  const [photos, setPhotos] = useState<TaskPhoto[]>([]);
  const [err, setErr] = useState<string | null>(null);

  // edycja
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState<string>("");
  const [priority, setPriority] = useState<TaskRow["priority"]>("MEDIUM");
  const [status, setStatus] = useState<TaskRow["status"]>("OPEN");
  const [assignedUserId, setAssignedUserId] = useState<string>("");

  // zdjęcia
  const [caption, setCaption] = useState<string>("");
  const [previewUrl, setPreviewUrl] = useState<string | null>(null);

  const canShow = open && !!taskId;

  const headerTitle = useMemo(() => {
    if (!taskId) return "Task";
    return task?.title ? `Task: ${task.title}` : `Task: ${taskId}`;
  }, [taskId, task?.title]);

  async function loadAll(id: string) {
    setErr(null);
    setLoading(true);
    try {
      // 1) task
      const r1 = await fetch(`/api/task?id=${encodeURIComponent(id)}`, { cache: "no-store" });
      const j1 = (await r1.json()) as ApiOk<TaskRow> | ApiErr;
      if (!r1.ok || !j1.ok) throw new Error((j1 as any)?.error?.message || "task fetch failed");
      setTask(j1.data);

      // ustaw pola edycji
      setTitle(j1.data.title || "");
      setDescription(j1.data.description || "");
      setPriority(j1.data.priority || "MEDIUM");
      setStatus(j1.data.status || "OPEN");
      setAssignedUserId(j1.data.assigned_user_id || "");

      // 2) photos
      const r2 = await fetch(`/api/task-photos?taskId=${encodeURIComponent(id)}`, { cache: "no-store" });
      const j2 = (await r2.json()) as ApiOk<TaskPhoto[]> | ApiErr;
      if (!r2.ok || !j2.ok) throw new Error((j2 as any)?.error?.message || "photos fetch failed");
      setPhotos(j2.data || []);
    } catch (e: any) {
      setErr(e?.message || String(e));
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    if (!canShow) return;
    if (!taskId) return;
    loadAll(taskId).catch(console.error);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [canShow, taskId]);

  async function save() {
    if (!taskId) return;
    setErr(null);

    if (!isUuid(taskId)) {
      setErr("taskId nie jest UUID");
      return;
    }
    if (!isUuid(uploadedBy)) {
      setErr("uploadedBy/changed_by nie jest UUID (DEV)");
      return;
    }

    // assigned_user_id może być pusty -> null
    let assigned_user_id: string | null = null;
    const trimmed = assignedUserId.trim();
    if (trimmed.length > 0) {
      if (!isUuid(trimmed)) {
        setErr("assigned_user_id musi być UUID albo puste");
        return;
      }
      assigned_user_id = trimmed;
    }

    setSaving(true);
    try {
      const r = await fetch("/api/tasks", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id: taskId,
          changed_by: uploadedBy,
          title: title.trim(),
          description: description.trim() === "" ? null : description,
          priority,
          status,
          assigned_user_id,
        }),
      });

      const j = (await r.json()) as ApiOk<TaskRow> | ApiErr;
      if (!r.ok || !j.ok) throw new Error((j as any)?.error?.message || "save failed");

      setTask(j.data);
      // po save — odśwież zdjęcia zostawiamy jak były
    } catch (e: any) {
      setErr(e?.message || String(e));
    } finally {
      setSaving(false);
    }
  }

  async function uploadPhoto(file: File) {
    if (!taskId) return;
    setErr(null);

    if (!isUuid(taskId)) {
      setErr("taskId nie jest UUID");
      return;
    }
    if (!isUuid(uploadedBy)) {
      setErr("uploadedBy nie jest UUID (DEV)");
      return;
    }

    setUploading(true);
    try {
      const base64 = await fileToBase64(file);

      const r = await fetch("/api/task-photos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          task_id: taskId,
          uploaded_by: uploadedBy,
          file_name: file.name || "photo.jpg",
          caption: caption.trim() === "" ? null : caption.trim(),
          base64,
        }),
      });

      const j = (await r.json()) as ApiOk<TaskPhoto> | ApiErr;
      if (!r.ok || !j.ok) throw new Error((j as any)?.error?.message || "upload failed");

      setCaption("");
      // dopnij na listę
      setPhotos((prev) => [j.data, ...prev]);
    } catch (e: any) {
      setErr(e?.message || String(e));
    } finally {
      setUploading(false);
    }
  }

  if (!open) return null;

  return (
    <>
      {/* overlay */}
      <div
        onClick={onClose}
        style={{
          position: "fixed",
          inset: 0,
          background: "rgba(0,0,0,0.35)",
          zIndex: 9998,
        }}
      />

      {/* drawer */}
      <div
        style={{
          position: "fixed",
          top: 0,
          right: 0,
          height: "100vh",
          width: "min(520px, 92vw)",
          background: "#fff",
          zIndex: 9999,
          boxShadow: "0 10px 30px rgba(0,0,0,0.25)",
          display: "flex",
          flexDirection: "column",
        }}
      >
        <div
          style={{
            padding: "12px 14px",
            borderBottom: "1px solid rgba(0,0,0,0.08)",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            gap: 10,
          }}
        >
          <div style={{ fontWeight: 800, fontSize: 14 }}>{headerTitle}</div>
          <button
            onClick={onClose}
            style={{
              padding: "6px 10px",
              borderRadius: 8,
              border: "1px solid rgba(0,0,0,0.15)",
              background: "#fff",
              cursor: "pointer",
              fontSize: 12,
            }}
          >
            Zamknij ✕
          </button>
        </div>

        <div style={{ padding: 14, overflow: "auto", flex: 1 }}>
          {loading ? <div style={{ opacity: 0.7 }}>Ładuję…</div> : null}
          {err ? (
            <div style={{ marginBottom: 12, padding: 10, borderRadius: 10, background: "rgba(255,0,0,0.08)" }}>
              <div style={{ fontWeight: 800, marginBottom: 4 }}>Błąd</div>
              <div style={{ fontFamily: "monospace", fontSize: 12, whiteSpace: "pre-wrap" }}>{err}</div>
            </div>
          ) : null}

          {!taskId ? <div style={{ opacity: 0.7 }}>Brak taskId</div> : null}

          {/* FORM */}
          <div style={{ display: "grid", gap: 10 }}>
            <label style={{ display: "grid", gap: 6 }}>
              <div style={{ fontSize: 12, opacity: 0.7 }}>Tytuł</div>
              <input
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                style={{
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(0,0,0,0.15)",
                  fontSize: 14,
                }}
              />
            </label>

            <label style={{ display: "grid", gap: 6 }}>
              <div style={{ fontSize: 12, opacity: 0.7 }}>Opis</div>
              <textarea
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                rows={4}
                style={{
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(0,0,0,0.15)",
                  fontSize: 14,
                  resize: "vertical",
                }}
              />
            </label>

            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
              <label style={{ display: "grid", gap: 6 }}>
                <div style={{ fontSize: 12, opacity: 0.7 }}>Priorytet</div>
                <select
                  value={priority}
                  onChange={(e) => setPriority(e.target.value as any)}
                  style={{ padding: "10px 12px", borderRadius: 10, border: "1px solid rgba(0,0,0,0.15)" }}
                >
                  <option value="LOW">LOW</option>
                  <option value="MEDIUM">MEDIUM</option>
                  <option value="HIGH">HIGH</option>
                  <option value="CRITICAL">CRITICAL</option>
                </select>
              </label>

              <label style={{ display: "grid", gap: 6 }}>
                <div style={{ fontSize: 12, opacity: 0.7 }}>Status</div>
                <select
                  value={status}
                  onChange={(e) => setStatus(e.target.value as any)}
                  style={{ padding: "10px 12px", borderRadius: 10, border: "1px solid rgba(0,0,0,0.15)" }}
                >
                  <option value="OPEN">OPEN</option>
                  <option value="IN_PROGRESS">IN_PROGRESS</option>
                  <option value="DONE_WAITING_APPROVAL">DONE_WAITING_APPROVAL</option>
                  <option value="APPROVED">APPROVED</option>
                  <option value="REJECTED">REJECTED</option>
                </select>
              </label>
            </div>

            <label style={{ display: "grid", gap: 6 }}>
              <div style={{ fontSize: 12, opacity: 0.7 }}>Przypisz do usera (UUID) — na razie ręcznie</div>
              <input
                placeholder="np. 11111111-1111-1111-1111-111111111111"
                value={assignedUserId}
                onChange={(e) => setAssignedUserId(e.target.value)}
                style={{
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(0,0,0,0.15)",
                  fontSize: 13,
                  fontFamily: "monospace",
                }}
              />
            </label>

            <div style={{ display: "flex", gap: 10, alignItems: "center" }}>
              <button
                disabled={saving || !taskId}
                onClick={save}
                style={{
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(0,0,0,0.15)",
                  background: saving ? "rgba(0,0,0,0.05)" : "#fff",
                  cursor: saving ? "not-allowed" : "pointer",
                  fontWeight: 700,
                }}
              >
                {saving ? "Zapisuję…" : "Zapisz"}
              </button>
              <div style={{ fontSize: 12, opacity: 0.65 }}>
                changed_by (DEV): <span style={{ fontFamily: "monospace" }}>{uploadedBy}</span>
              </div>
            </div>
          </div>

          <hr style={{ margin: "16px 0", border: "none", borderTop: "1px solid rgba(0,0,0,0.08)" }} />

          {/* PHOTOS */}
          <div style={{ display: "grid", gap: 10 }}>
            <div style={{ fontWeight: 800 }}>Zdjęcia</div>

            <div style={{ display: "grid", gap: 8 }}>
              <label style={{ display: "grid", gap: 6 }}>
                <div style={{ fontSize: 12, opacity: 0.7 }}>Podpis (opcjonalnie)</div>
                <input
                  value={caption}
                  onChange={(e) => setCaption(e.target.value)}
                  style={{
                    padding: "10px 12px",
                    borderRadius: 10,
                    border: "1px solid rgba(0,0,0,0.15)",
                    fontSize: 14,
                  }}
                />
              </label>

              <label style={{ display: "inline-flex", alignItems: "center", gap: 10 }}>
                <input
                  type="file"
                  accept="image/*"
                  disabled={uploading || !taskId}
                  onChange={async (e) => {
                    const f = e.target.files?.[0];
                    if (!f) return;
                    await uploadPhoto(f);
onChange={async (e) => {
  const input = e.currentTarget; // złap input zanim await
  const f = input.files?.[0];
  if (!f) return;

  await uploadPhoto(f);

  input.value = "";
}}
                  }}
                />
                <span style={{ fontSize: 12, opacity: 0.7 }}>{uploading ? "Wysyłam…" : ""}</span>
              </label>
            </div>

            {photos.length === 0 ? <div style={{ fontSize: 12, opacity: 0.7 }}>Brak zdjęć.</div> : null}

            {/* miniaturki */}
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
                gap: 8,
              }}
            >
              {photos.map((p) => (
                <button
                  key={p.id}
                  onClick={() => setPreviewUrl(p.url)}
                  style={{
                    border: "1px solid rgba(0,0,0,0.12)",
                    borderRadius: 12,
                    padding: 0,
                    overflow: "hidden",
                    background: "#fff",
                    cursor: "pointer",
                  }}
                  title={p.caption || ""}
                >
                  <img
                    src={p.url}
                    alt={p.caption || "photo"}
                    style={{
                      width: "100%",
                      height: 110,
                      objectFit: "cover",
                      display: "block",
                    }}
                  />
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* lightbox */}
      {previewUrl ? (
        <div
          onClick={() => setPreviewUrl(null)}
          style={{
            position: "fixed",
            inset: 0,
            zIndex: 10000,
            background: "rgba(0,0,0,0.75)",
            display: "grid",
            placeItems: "center",
            padding: 18,
          }}
        >
          <img
            src={previewUrl}
            alt="preview"
            style={{
              maxWidth: "95vw",
              maxHeight: "90vh",
              borderRadius: 14,
              boxShadow: "0 10px 30px rgba(0,0,0,0.35)",
              background: "#fff",
            }}
          />
        </div>
      ) : null}
    </>
  );
}
