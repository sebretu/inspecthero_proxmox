"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { MapContainer, TileLayer, Marker, Popup, useMapEvents } from "react-leaflet";
import L from "leaflet";
import "leaflet/dist/leaflet.css";

type Meta = {
  tileSize: number;
  minZoom: number;
  maxZoom: number;
  gridW: number; // liczba kafli na maxZoom
  gridH: number; // liczba kafli na maxZoom
};

type TaskRow = {
  id: string;
  plan_id: string;
  project_id: string;
  x_norm: number;
  y_norm: number;
  title: string;
  description: string | null;
  priority?: string;
  status?: string;
  assigned_user_id?: string | null;
};

type ProfileRow = {
  id: string;
  full_name: string;
  email: string;
  role: string;
  is_active: boolean;
  company_id: string;
};

type TaskPhoto = {
  id: string;
  task_id: string;
  url: string;
  caption: string | null;
  uploaded_by: string;
  created_at: string;
};

function clamp01(n: number) {
  return Math.max(0, Math.min(1, n));
}

function shortId(id: string | null | undefined) {
  if (!id) return "—";
  if (id.length <= 12) return id;
  return `${id.slice(0, 6)}…${id.slice(-4)}`;
}

// Poprawny CRS
const CRS = L.CRS.Simple;

// Leaflet default icons fix (Next.js)
delete (L.Icon.Default.prototype as any)._getIconUrl;
L.Icon.Default.mergeOptions({
  iconRetinaUrl: "/leaflet/images/marker-icon-2x.png",
  iconUrl: "/leaflet/images/marker-icon.png",
  shadowUrl: "/leaflet/images/marker-shadow.png",
});

export default function PlanMap({ planId, meta }: { planId: string; meta: Meta }) {
  // DEMO (na razie na sztywno)
  const PROJECT_ID = "55555555-5555-5555-5555-555555555555";
  const CREATED_BY = "44444444-4444-4444-4444-444444444444";

  // startowy zoom (ustaw tutaj)
  const START_ZOOM = 2;

  const [tasks, setTasks] = useState<TaskRow[]>([]);
  const [tasksLoading, setTasksLoading] = useState(false);
  const [map, setMap] = useState<L.Map | null>(null);

  // profile cache: id -> ProfileRow
  const [profileById, setProfileById] = useState<Record<string, ProfileRow>>({});
  const [profilesLoaded, setProfilesLoaded] = useState(false);

  // miniaturki: taskId -> (null = brak lub jeszcze nie ma), string = url
  // UWAGA: używamy hasOwnProperty żeby odróżnić "nie próbowano" od "spróbowano i brak"
  const [thumbByTaskId, setThumbByTaskId] = useState<Record<string, string | null>>({});

  // Rozmiar świata w pikselach NA maxZoom (bo gridW/gridH są dla maxZoom)
  const worldPxW = meta.gridW * meta.tileSize;
  const worldPxH = meta.gridH * meta.tileSize;

  const bounds = useMemo(() => {
    const sw = CRS.pointToLatLng(L.point(0, worldPxH), meta.maxZoom);
    const ne = CRS.pointToLatLng(L.point(worldPxW, 0), meta.maxZoom);
    return L.latLngBounds(sw, ne);
  }, [worldPxW, worldPxH, meta.maxZoom]);

  const center = useMemo(() => bounds.getCenter(), [bounds]);

  const loadTasks = useCallback(async () => {
    setTasksLoading(true);
    try {
      const r = await fetch(`/api/tasks?projectId=${PROJECT_ID}&planId=${planId}&limit=200&offset=0`, {
        cache: "no-store",
      });
      const j = await r.json();
      if (!r.ok || !j?.ok) throw new Error(j?.error?.message || "tasks fetch failed");
      setTasks(j.data || []);
    } finally {
      setTasksLoading(false);
    }
  }, [PROJECT_ID, planId]);

  const loadProfiles = useCallback(async () => {
    try {
      const r = await fetch(`/api/profiles?limit=500`, { cache: "no-store" });
      const j = await r.json();
      if (!r.ok || !j?.ok) return;

      const next: Record<string, ProfileRow> = {};
      for (const p of j.data || []) {
        if (p?.id) next[String(p.id)] = p as ProfileRow;
      }
      setProfileById(next);
      setProfilesLoaded(true);
    } catch {
      // ignorujemy — popup pokaże skrót UUID
    }
  }, []);

  useEffect(() => {
    loadTasks().catch(console.error);
  }, [loadTasks]);

  useEffect(() => {
    // ładujemy raz (może być nawet bez auth w DEV bo endpoint używa service key)
    if (profilesLoaded) return;
    loadProfiles().catch(console.error);
  }, [profilesLoaded, loadProfiles]);

  // start map
  useEffect(() => {
    if (!map) return;
    map.setMaxBounds(bounds);
    const z = Math.max(meta.minZoom, Math.min(meta.maxZoom, START_ZOOM));
    map.setView(center, z, { animate: false });
  }, [map, bounds, center, meta.minZoom, meta.maxZoom]);

  function ClickToCreate() {
    useMapEvents({
      click: async (e) => {
        // LatLng → piksele na maxZoom
        const p = CRS.latLngToPoint(e.latlng, meta.maxZoom);
        const x = p.x;
        const y = p.y;

        const x_norm = clamp01(x / worldPxW);
        const y_norm = clamp01(y / worldPxH);

        const title = window.prompt("Tytuł taska?", "Nowy task");
        if (!title) return;

        const description = (window.prompt("Opis (opcjonalnie)?", "") || "").trim() || null;

        const r = await fetch("/api/tasks", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            project_id: PROJECT_ID,
            plan_id: planId,
            x_norm,
            y_norm,
            title,
            description,
            created_by: CREATED_BY,
          }),
        });

        const j = await r.json();
        if (!r.ok || !j?.ok) {
          alert(`Błąd: ${j?.error?.message || j?.error || r.status}`);
          return;
        }

        await loadTasks();
      },
    });

    return null;
  }

  const ensureThumb = async (taskId: string) => {
    // jeśli już próbowaliśmy (jest klucz) -> nie ładuj ponownie
    if (Object.prototype.hasOwnProperty.call(thumbByTaskId, taskId)) return;

    // zaznacz jako "w trakcie / brak" (żeby UI nie migał)
    setThumbByTaskId((prev) => ({ ...prev, [taskId]: null }));

    try {
      const r = await fetch(`/api/task-photos?taskId=${encodeURIComponent(taskId)}&limit=1`, { cache: "no-store" });
      const j = await r.json();
      if (!r.ok || !j?.ok) return;

      const arr = (j.data || []) as TaskPhoto[];
      const first = arr[0];
      if (first?.url) {
        setThumbByTaskId((prev) => ({ ...prev, [taskId]: String(first.url) }));
      } else {
        setThumbByTaskId((prev) => ({ ...prev, [taskId]: null }));
      }
    } catch {
      // nic
    }
  };

  const renderAssigned = (assigned_user_id?: string | null) => {
    if (!assigned_user_id) return "—";
    const p = profileById[assigned_user_id];
    if (p?.full_name) return p.full_name;
    return shortId(assigned_user_id);
  };

  return (
    <div style={{ width: "100%", height: "calc(100vh - 120px)" }}>
      <div style={{ padding: "6px 10px", fontSize: 12, opacity: 0.75 }}>
        tasks: {tasks.length} {tasksLoading ? "(loading…)" : ""} | planId:{" "}
        <span style={{ fontFamily: "monospace" }}>{planId}</span>
      </div>

      <MapContainer
        crs={CRS}
        whenCreated={setMap}
        center={center}
        zoom={Math.max(meta.minZoom, Math.min(meta.maxZoom, START_ZOOM))}
        minZoom={meta.minZoom}
        maxZoom={meta.maxZoom}
        bounds={bounds}
        maxBounds={bounds}
        maxBoundsViscosity={1.0}
        style={{ width: "100%", height: "100%", background: "#fff" }}
      >
        <TileLayer
          url={`/api/tiles/${planId}/{z}/{x}/{y}.png`}
          tileSize={meta.tileSize}
          minZoom={meta.minZoom}
          maxZoom={meta.maxZoom}
          minNativeZoom={meta.minZoom}
          maxNativeZoom={meta.maxZoom}
          tms={false}
          noWrap={true}
          keepBuffer={4}
          className="plan-tiles"
        />

        <ClickToCreate />

        {tasks.map((t) => {
          const x = Number(t.x_norm) * worldPxW;
          const y = Number(t.y_norm) * worldPxH;
          const ll = CRS.pointToLatLng(L.point(x, y), meta.maxZoom);

          const thumb = thumbByTaskId[t.id]; // undefined: nie próbowano, null: brak/ładowanie, string: url

          return (
            <Marker key={t.id} position={ll}>
              <Popup
                eventHandlers={{
                  popupopen: () => {
                    ensureThumb(t.id).catch(() => {});
                  },
                }}
              >
                <div style={{ minWidth: 260, maxWidth: 320 }}>
                  <div style={{ fontWeight: 800 }}>{t.title}</div>

                  {/* meta */}
                  <div style={{ marginTop: 8, fontSize: 12, opacity: 0.9, display: "grid", gap: 4 }}>
                    <div>
                      <span style={{ opacity: 0.7 }}>Status:</span> <b>{t.status || "—"}</b>
                    </div>
                    <div>
                      <span style={{ opacity: 0.7 }}>Priorytet:</span> <b>{t.priority || "—"}</b>
                    </div>
                    <div>
                      <span style={{ opacity: 0.7 }}>Przydzielone:</span> <b>{renderAssigned(t.assigned_user_id)}</b>
                    </div>
                  </div>

                  {t.description ? (
                    <div style={{ marginTop: 8, fontSize: 13, lineHeight: 1.35, opacity: 0.9 }}>{t.description}</div>
                  ) : null}

                  {/* miniaturka */}
                  <div style={{ marginTop: 10 }}>
                    {typeof thumb === "string" ? (
                      <img
                        src={thumb}
                        alt="miniatura"
                        style={{
                          width: "100%",
                          height: 110,
                          objectFit: "cover",
                          borderRadius: 12,
                          border: "1px solid rgba(0,0,0,0.12)",
                          display: "block",
                        }}
                      />
                    ) : (
                      <div
                        style={{
                          width: "100%",
                          height: 110,
                          borderRadius: 12,
                          border: "1px dashed rgba(0,0,0,0.2)",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          fontSize: 12,
                          opacity: 0.7,
                        }}
                      >
                        {Object.prototype.hasOwnProperty.call(thumbByTaskId, t.id) ? "Brak zdjęcia" : "Ładuję…"}
                      </div>
                    )}
                  </div>

                  {/* actions */}
                  <div style={{ marginTop: 10, display: "flex", gap: 8, alignItems: "center" }}>
                    <a
                      href={`/task/${t.id}`}
                      style={{
                        padding: "7px 10px",
                        borderRadius: 10,
                        border: "1px solid rgba(0,0,0,0.15)",
                        background: "#fff",
                        cursor: "pointer",
                        fontSize: 12,
                        textDecoration: "none",
                        color: "inherit",
                        display: "inline-block",
                      }}
                    >
                      Otwórz task →
                    </a>

                    <span style={{ fontSize: 11, opacity: 0.6, fontFamily: "monospace" }}>{t.id}</span>
                  </div>
                </div>
              </Popup>
            </Marker>
          );
        })}
      </MapContainer>
    </div>
  );
}
