"use client";

import { useEffect, useMemo, useState } from "react";

type ApiOk<T> = { ok: true; data: T; meta?: any };
type ApiErr = { ok: false; error: { code: string; message: string; meta?: any } };

type TaskRow = {
  id: string;
  project_id: string;
  plan_id: string;
  title: string;
  description: string | null;
  priority: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL";
  status: "OPEN" | "IN_PROGRESS" | "DONE_WAITING_APPROVAL" | "APPROVED" | "REJECTED";
  due_date: string | null;
  assigned_user_id: string | null;
  created_at: string;
  updated_at: string;
};

type TaskPhoto = {
  id: string;
  task_id: string;
  url: string;
  caption: string | null;
  uploaded_by: string;
  created_at: string;
};

function isUuid(v: string) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v);
}

async function fileToBase64(file: File): Promise<string> {
  const buf = await file.arrayBuffer();
  const bytes = new Uint8Array(buf);
  let binary = "";
  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
  return btoa(binary);
}

function badgeColor(status: TaskRow["status"]) {
  switch (status) {
    case "OPEN":
      return { bg: "rgba(59,130,246,0.12)", fg: "#1d4ed8", border: "rgba(29,78,216,0.18)" };
    case "IN_PROGRESS":
      return { bg: "rgba(245,158,11,0.14)", fg: "#92400e", border: "rgba(146,64,14,0.18)" };
    case "DONE_WAITING_APPROVAL":
      return { bg: "rgba(168,85,247,0.12)", fg: "#6d28d9", border: "rgba(109,40,217,0.18)" };
    case "APPROVED":
      return { bg: "rgba(34,197,94,0.12)", fg: "#166534", border: "rgba(22,101,52,0.18)" };
    case "REJECTED":
      return { bg: "rgba(239,68,68,0.12)", fg: "#991b1b", border: "rgba(153,27,27,0.18)" };
    default:
      return { bg: "rgba(17,24,39,0.06)", fg: "#111827", border: "rgba(17,24,39,0.10)" };
  }
}

export default function TaskDrawer({
  open,
  taskId,
  onClose,
  uploadedBy,
}: {
  open: boolean;
  taskId: string | null;
  onClose: () => void;
  uploadedBy: string;
}) {
  const [task, setTask] = useState<TaskRow | null>(null);
  const [photos, setPhotos] = useState<TaskPhoto[]>([]);
  const [err, setErr] = useState<string | null>(null);
  const [okMsg, setOkMsg] = useState<string | null>(null);

  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [priority, setPriority] = useState<TaskRow["priority"]>("MEDIUM");
  const [status, setStatus] = useState<TaskRow["status"]>("OPEN");
  const [assignedUserId, setAssignedUserId] = useState("");

  const [caption, setCaption] = useState("");
  const [uploading, setUploading] = useState(false);
  const [saving, setSaving] = useState(false);

  const [previewUrl, setPreviewUrl] = useState<string | null>(null);

  const canShow = open && !!taskId;

  const headerTitle = useMemo(() => (task?.title ? task.title : "Task"), [task?.title]);

  async function loadAll(id: string) {
    setErr(null);
    setOkMsg(null);
    try {
      const r1 = await fetch(`/api/task?id=${encodeURIComponent(id)}`, { cache: "no-store" });
      const j1 = (await r1.json()) as ApiOk<TaskRow> | ApiErr;
      if (!r1.ok || !j1.ok) throw new Error((j1 as any)?.error?.message || "task fetch failed");

      setTask(j1.data);
      setTitle(j1.data.title || "");
      setDescription(j1.data.description || "");
      setPriority(j1.data.priority || "MEDIUM");
      setStatus(j1.data.status || "OPEN");
      setAssignedUserId(j1.data.assigned_user_id || "");

      const r2 = await fetch(`/api/task-photos?taskId=${encodeURIComponent(id)}`, { cache: "no-store" });
      const j2 = (await r2.json()) as ApiOk<TaskPhoto[]> | ApiErr;
      if (!r2.ok || !j2.ok) throw new Error((j2 as any)?.error?.message || "photos fetch failed");

      setPhotos(j2.data || []);
    } catch (e: any) {
      setErr(e?.message || String(e));
    }
  }

  useEffect(() => {
    if (canShow && taskId) loadAll(taskId);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [canShow, taskId]);

  async function save() {
    setErr(null);
    setOkMsg(null);

    if (!taskId) {
      setErr("Brak taskId");
      return;
    }
    if (!isUuid(taskId)) {
      setErr("taskId nie jest UUID");
      return;
    }
    if (!isUuid(uploadedBy)) {
      setErr("uploadedBy/changed_by nie jest UUID (DEV)");
      return;
    }

    const assigned_user_id = assignedUserId.trim() === "" ? null : assignedUserId.trim();
    if (assigned_user_id && !isUuid(assigned_user_id)) {
      setErr("assigned_user_id musi być UUID albo puste");
      return;
    }

    setSaving(true);
    try {
      const r = await fetch("/api/tasks", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id: taskId,
          changed_by: uploadedBy,
          title: title.trim(),
          description: description.trim() === "" ? null : description.trim(),
          priority,
          status,
          assigned_user_id,
        }),
      });

      const j = (await r.json()) as ApiOk<TaskRow> | ApiErr;
      if (!r.ok || !j.ok) throw new Error((j as any)?.error?.message || "save failed");

      setTask(j.data);
      setOkMsg("Zapisano ✅");
      // odśwież foty nie musimy, ale task tak (już ustawiony)
    } catch (e: any) {
      setErr(e?.message || String(e));
    } finally {
      setSaving(false);
    }
  }

  async function uploadPhoto(file: File) {
    setErr(null);
    setOkMsg(null);

    if (!taskId) {
      setErr("Brak taskId");
      return;
    }
    if (!isUuid(taskId)) {
      setErr("taskId nie jest UUID");
      return;
    }
    if (!isUuid(uploadedBy)) {
      setErr("uploadedBy nie jest UUID (DEV)");
      return;
    }

    setUploading(true);
    try {
      const base64 = await fileToBase64(file);

      const r = await fetch("/api/task-photos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          task_id: taskId,
          uploaded_by: uploadedBy,
          file_name: file.name || "photo.jpg",
          caption: caption.trim() === "" ? null : caption.trim(),
          base64,
        }),
      });

      const j = (await r.json()) as ApiOk<TaskPhoto> | ApiErr;
      if (!r.ok || !j.ok) throw new Error((j as any)?.error?.message || "upload failed");

      setPhotos((prev) => [j.data, ...prev]);
      setCaption("");
      setOkMsg("Dodano zdjęcie ✅");
    } catch (e: any) {
      setErr(e?.message || String(e));
    } finally {
      setUploading(false);
    }
  }

  if (!open) return null;

  const statusBadge = task ? badgeColor(status) : badgeColor("OPEN");

  return (
    <>
      {/* overlay */}
      <div
        onClick={onClose}
        style={{
          position: "fixed",
          inset: 0,
          background: "rgba(0,0,0,0.45)",
          zIndex: 9998,
        }}
      />

      {/* CARD */}
      <div
        style={{
          position: "fixed",
          top: 24,
          right: 24,
          bottom: 24,
          width: "min(560px, 96vw)",
          background: "linear-gradient(180deg, #ffffff, #f9fafb)",
          borderRadius: 18,
          boxShadow: "0 25px 60px rgba(0,0,0,0.35)",
          border: "1px solid rgba(0,0,0,0.08)",
          zIndex: 9999,
          display: "flex",
          flexDirection: "column",
          overflow: "hidden",
          color: "#111827",
        }}
      >
        {/* HEADER */}
        <div
          style={{
            padding: "14px 16px",
            borderBottom: "1px solid rgba(0,0,0,0.08)",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            gap: 12,
          }}
        >
          <div style={{ display: "grid", gap: 6 }}>
            <div style={{ fontWeight: 950, fontSize: 14, letterSpacing: 0.2 }}>{headerTitle}</div>
            <div style={{ display: "flex", gap: 8, alignItems: "center", flexWrap: "wrap" }}>
              <span
                style={{
                  display: "inline-flex",
                  alignItems: "center",
                  padding: "4px 10px",
                  borderRadius: 999,
                  border: `1px solid ${statusBadge.border}`,
                  background: statusBadge.bg,
                  color: statusBadge.fg,
                  fontSize: 12,
                  fontWeight: 800,
                }}
              >
                {status}
              </span>
              <span style={{ fontSize: 12, opacity: 0.7 }}>
                {taskId ? (
                  <span style={{ fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace" }}>{taskId}</span>
                ) : (
                  "Brak taskId"
                )}
              </span>
            </div>
          </div>

          <button
            onClick={onClose}
            style={{
              border: "1px solid rgba(0,0,0,0.12)",
              background: "#fff",
              borderRadius: 12,
              width: 40,
              height: 40,
              cursor: "pointer",
              fontWeight: 900,
            }}
            aria-label="Zamknij"
            type="button"
          >
            ✕
          </button>
        </div>

        {/* BODY */}
        <div style={{ padding: 16, overflow: "auto", display: "grid", gap: 14 }}>
          {err ? (
            <div
              style={{
                background: "rgba(239,68,68,0.10)",
                border: "1px solid rgba(239,68,68,0.18)",
                color: "#991b1b",
                padding: "10px 12px",
                borderRadius: 12,
                fontSize: 13,
                fontWeight: 700,
              }}
            >
              {err}
            </div>
          ) : null}

          {okMsg ? (
            <div
              style={{
                background: "rgba(34,197,94,0.10)",
                border: "1px solid rgba(34,197,94,0.18)",
                color: "#166534",
                padding: "10px 12px",
                borderRadius: 12,
                fontSize: 13,
                fontWeight: 800,
              }}
            >
              {okMsg}
            </div>
          ) : null}

          {/* FORM */}
          <div style={{ display: "grid", gap: 10 }}>
            <label style={{ display: "grid", gap: 6 }}>
              <div style={{ fontSize: 12, fontWeight: 900, opacity: 0.85 }}>Tytuł</div>
              <input
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                style={{
                  padding: "10px 12px",
                  borderRadius: 12,
                  border: "1px solid rgba(0,0,0,0.15)",
                  background: "#fff",
                  fontSize: 14,
                  outline: "none",
                }}
              />
            </label>

            <label style={{ display: "grid", gap: 6 }}>
              <div style={{ fontSize: 12, fontWeight: 900, opacity: 0.85 }}>Opis</div>
              <textarea
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                rows={4}
                style={{
                  padding: "10px 12px",
                  borderRadius: 12,
                  border: "1px solid rgba(0,0,0,0.15)",
                  background: "#fff",
                  fontSize: 14,
                  outline: "none",
                  resize: "vertical",
                }}
              />
            </label>

            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
              <label style={{ display: "grid", gap: 6 }}>
                <div style={{ fontSize: 12, fontWeight: 900, opacity: 0.85 }}>Status</div>
                <select
                  value={status}
                  onChange={(e) => setStatus(e.target.value as TaskRow["status"])}
                  style={{
                    padding: "10px 12px",
                    borderRadius: 12,
                    border: "1px solid rgba(0,0,0,0.15)",
                    background: "#fff",
                    fontSize: 14,
                    outline: "none",
                  }}
                >
                  <option value="OPEN">OPEN</option>
                  <option value="IN_PROGRESS">IN_PROGRESS</option>
                  <option value="DONE_WAITING_APPROVAL">DONE_WAITING_APPROVAL</option>
                  <option value="APPROVED">APPROVED</option>
                  <option value="REJECTED">REJECTED</option>
                </select>
              </label>

              <label style={{ display: "grid", gap: 6 }}>
                <div style={{ fontSize: 12, fontWeight: 900, opacity: 0.85 }}>Priority</div>
                <select
                  value={priority}
                  onChange={(e) => setPriority(e.target.value as TaskRow["priority"])}
                  style={{
                    padding: "10px 12px",
                    borderRadius: 12,
                    border: "1px solid rgba(0,0,0,0.15)",
                    background: "#fff",
                    fontSize: 14,
                    outline: "none",
                  }}
                >
                  <option value="LOW">LOW</option>
                  <option value="MEDIUM">MEDIUM</option>
                  <option value="HIGH">HIGH</option>
                  <option value="CRITICAL">CRITICAL</option>
                </select>
              </label>
            </div>

            <label style={{ display: "grid", gap: 6 }}>
              <div style={{ fontSize: 12, fontWeight: 900, opacity: 0.85 }}>
                assigned_user_id (na razie UUID albo puste)
              </div>
              <input
                value={assignedUserId}
                onChange={(e) => setAssignedUserId(e.target.value)}
                placeholder="np. 4444... albo puste"
                style={{
                  padding: "10px 12px",
                  borderRadius: 12,
                  border: "1px solid rgba(0,0,0,0.15)",
                  background: "#fff",
                  fontSize: 14,
                  outline: "none",
                  fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
                }}
              />
            </label>

            <button
              type="button"
              onClick={save}
              disabled={saving || !taskId}
              style={{
                marginTop: 2,
                padding: "12px 14px",
                borderRadius: 14,
                border: "1px solid rgba(0,0,0,0.10)",
                background: saving ? "rgba(17,24,39,0.55)" : "#111827",
                color: "#fff",
                fontWeight: 950,
                cursor: saving ? "default" : "pointer",
              }}
            >
              {saving ? "Zapisuję…" : "Zapisz zmiany"}
            </button>
          </div>

          <hr style={{ border: "none", borderTop: "1px solid rgba(0,0,0,0.08)" }} />

          {/* PHOTOS */}
          <div style={{ display: "grid", gap: 10 }}>
            <div style={{ fontWeight: 950 }}>Zdjęcia</div>

            <div style={{ display: "grid", gap: 8 }}>
              <label style={{ display: "grid", gap: 6 }}>
                <div style={{ fontSize: 12, opacity: 0.75, fontWeight: 800 }}>Podpis (opcjonalnie)</div>
                <input
                  value={caption}
                  onChange={(e) => setCaption(e.target.value)}
                  style={{
                    padding: "10px 12px",
                    borderRadius: 12,
                    border: "1px solid rgba(0,0,0,0.15)",
                    background: "#fff",
                    fontSize: 14,
                    outline: "none",
                  }}
                />
              </label>

              <label style={{ display: "inline-flex", alignItems: "center", gap: 10 }}>
                <input
                  type="file"
                  accept="image/*"
                  disabled={uploading || !taskId}
                  onChange={async (e) => {
                    const input = e.currentTarget;
                    const f = input.files?.[0];
                    // reset OD RAZU (żeby można było wybrać to samo zdjęcie jeszcze raz)
                    input.value = "";
                    if (!f) return;
                    await uploadPhoto(f);
                  }}
                />
                <span style={{ fontSize: 12, opacity: 0.75, fontWeight: 800 }}>
                  {uploading ? "Wysyłam…" : ""}
                </span>
              </label>
            </div>

            {photos.length === 0 ? <div style={{ fontSize: 12, opacity: 0.7 }}>Brak zdjęć.</div> : null}

            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
                gap: 8,
              }}
            >
              {photos.map((p) => (
                <button
                  key={p.id}
                  type="button"
                  onClick={() => setPreviewUrl(p.url)}
                  style={{
                    border: "1px solid rgba(0,0,0,0.12)",
                    borderRadius: 12,
                    padding: 0,
                    overflow: "hidden",
                    background: "#fff",
                    cursor: "pointer",
                  }}
                >
                  <img
                    src={p.url}
                    alt={p.caption || "task photo"}
                    style={{
                      width: "100%",
                      height: 110,
                      objectFit: "cover",
                      display: "block",
                    }}
                  />
                </button>
              ))}
            </div>
          </div>

          {/* DEV info */}
          <div style={{ fontSize: 12, opacity: 0.7 }}>
            changed_by/uploaded_by:{" "}
            <span style={{ fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace" }}>{uploadedBy}</span>
          </div>
        </div>
      </div>

      {/* PREVIEW */}
      {previewUrl ? (
        <div
          onClick={() => setPreviewUrl(null)}
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,0.72)",
            zIndex: 10000,
            display: "grid",
            placeItems: "center",
            padding: 18,
          }}
        >
          <img
            src={previewUrl}
            alt="preview"
            style={{
              maxWidth: "min(1000px, 96vw)",
              maxHeight: "92vh",
              borderRadius: 16,
              boxShadow: "0 30px 80px rgba(0,0,0,0.55)",
              background: "#fff",
            }}
          />
        </div>
      ) : null}
    </>
  );
}
