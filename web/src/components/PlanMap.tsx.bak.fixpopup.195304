"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { MapContainer, TileLayer, Marker, Popup, useMapEvents } from "react-leaflet";
import L from "leaflet";
import "leaflet/dist/leaflet.css";
import TaskDrawer from "./TaskDrawer";

type Meta = {
  tileSize: number;
  minZoom: number;
  maxZoom: number;
  gridW: number;
  gridH: number;
};

type TaskRow = {
  id: string;
  plan_id: string;
  project_id: string;
  x_norm: number;
  y_norm: number;
  title: string;
  description: string | null;
  status?: string;
  assigned_user_id?: string | null;
};

type TaskPhoto = {
  id: string;
  task_id: string;
  url: string;
};

const CRS = L.CRS.Simple;

delete (L.Icon.Default.prototype as any)._getIconUrl;
L.Icon.Default.mergeOptions({
  iconRetinaUrl: "/leaflet/images/marker-icon-2x.png",
  iconUrl: "/leaflet/images/marker-icon.png",
  shadowUrl: "/leaflet/images/marker-shadow.png",
});

export default function PlanMap({ planId, meta }: { planId: string; meta: Meta }) {
  const PROJECT_ID = "55555555-5555-5555-5555-555555555555";
  const CREATED_BY = "44444444-4444-4444-4444-444444444444";

  const [tasks, setTasks] = useState<TaskRow[]>([]);
  const [thumbByTask, setThumbByTask] = useState<Record<string, string | null>>({});
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [selectedTaskId, setSelectedTaskId] = useState<string | null>(null);

  const worldPxW = meta.gridW * meta.tileSize;
  const worldPxH = meta.gridH * meta.tileSize;

  const bounds = useMemo(() => {
    const sw = CRS.pointToLatLng(L.point(0, worldPxH), meta.maxZoom);
    const ne = CRS.pointToLatLng(L.point(worldPxW, 0), meta.maxZoom);
    return L.latLngBounds(sw, ne);
  }, [worldPxW, worldPxH, meta.maxZoom]);

  const center = bounds.getCenter();

  const loadTasks = useCallback(async () => {
    const r = await fetch(`/api/tasks?projectId=${PROJECT_ID}&planId=${planId}&limit=200&offset=0`);
    const j = await r.json();
    if (j?.ok) setTasks(j.data || []);
  }, [PROJECT_ID, planId]);

  useEffect(() => {
    loadTasks();
  }, [loadTasks]);

  async function ensureThumb(taskId: string) {
    if (taskId in thumbByTask) return;
    setThumbByTask((p) => ({ ...p, [taskId]: null }));

    const r = await fetch(`/api/task-photos?taskId=${taskId}`);
    const j = await r.json();
    if (j?.ok && j.data.length > 0) {
      setThumbByTask((p) => ({ ...p, [taskId]: j.data[0].url }));
    }
  }

  function ClickToCreate() {
    useMapEvents({
      click: async (e) => {
        const p = CRS.latLngToPoint(e.latlng, meta.maxZoom);
        const x_norm = p.x / worldPxW;
        const y_norm = p.y / worldPxH;

        const r = await fetch("/api/tasks", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            project_id: PROJECT_ID,
            plan_id: planId,
            x_norm,
            y_norm,
            title: "Nowy task",
            description: null,
            created_by: CREATED_BY,
          }),
        });

        const j = await r.json();
        if (j?.ok) {
          setSelectedTaskId(j.data.id);
          setDrawerOpen(true);
          loadTasks();
        }
      },
    });
    return null;
  }

  return (
    <>
      <MapContainer
        crs={CRS}
        center={center}
        zoom={meta.minZoom}
        minZoom={meta.minZoom}
        maxZoom={meta.maxZoom}
        bounds={bounds}
        style={{ height: "100vh" }}
      >
        <TileLayer url={`/api/tiles/${planId}/{z}/{x}/{y}.png`} />

        <ClickToCreate />

        {tasks.map((t) => {
          const x = t.x_norm * worldPxW;
          const y = t.y_norm * worldPxH;
          const ll = CRS.pointToLatLng(L.point(x, y), meta.maxZoom);
          const thumb = thumbByTask[t.id];

          return (
            <Marker
              key={t.id}
              position={ll}
              eventHandlers={{
                popupopen: () => ensureThumb(t.id),
              }}
            >
              <Popup>
                <div style={{ width: 220, color: "#111827" }}>
                  {thumb ? (
                    <img
                      src={thumb}
                      style={{ width: "100%", borderRadius: 8, marginBottom: 6 }}
                    />
                  ) : (
                    <div style={{ fontSize: 12, opacity: 0.6 }}>Brak zdjęcia</div>
                  )}

                  <div style={{ fontWeight: 700 }}>{t.title}</div>

                  <button
                    onClick={() => {
                      setSelectedTaskId(t.id);
                      setDrawerOpen(true);
                    }}
                    style={{
                      marginTop: 8,
                      padding: "6px 10px",
                      width: "100%",
                      borderRadius: 8,
                      border: "1px solid #111827",
                      background: "#fff",
                      color: "#111827",
                      fontWeight: 600,
                      cursor: "pointer",
                    }}
                  >
                    Otwórz task
                  </button>
                </div>
              </Popup>
            </Marker>
          );
        })}
      </MapContainer>

      <TaskDrawer
        open={drawerOpen}
        taskId={selectedTaskId}
        uploadedBy={CREATED_BY}
        onClose={() => {
          setDrawerOpen(false);
          loadTasks();
        }}
      />
    </>
  );
}
