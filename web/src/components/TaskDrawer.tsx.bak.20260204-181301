"use client";

import { useEffect, useMemo, useState } from "react";

type ApiOk<T> = { ok: true; data: T };
type ApiErr = { ok: false; error: { code: string; message: string; meta?: any } };

type TaskRow = {
  id: string;
  project_id: string;
  plan_id: string;
  title: string;
  description: string | null;
  priority: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL";
  status: "OPEN" | "IN_PROGRESS" | "DONE_WAITING_APPROVAL" | "APPROVED" | "REJECTED";
  due_date: string | null;
  assigned_user_id: string | null;
  created_at: string;
  updated_at: string;
};

type TaskPhoto = {
  id: string;
  task_id: string;
  url: string;
  caption: string | null;
  uploaded_by: string;
  created_at: string;
};

function isUuid(v: string) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v);
}

async function fileToBase64(file: File): Promise<string> {
  const buf = await file.arrayBuffer();
  const bytes = new Uint8Array(buf);
  let binary = "";
  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
  return btoa(binary);
}

export default function TaskDrawer({
  open,
  taskId,
  onClose,
  uploadedBy,
}: {
  open: boolean;
  taskId: string | null;
  onClose: () => void;
  uploadedBy: string;
}) {
  const [task, setTask] = useState<TaskRow | null>(null);
  const [photos, setPhotos] = useState<TaskPhoto[]>([]);
  const [err, setErr] = useState<string | null>(null);

  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [priority, setPriority] = useState<TaskRow["priority"]>("MEDIUM");
  const [status, setStatus] = useState<TaskRow["status"]>("OPEN");
  const [assignedUserId, setAssignedUserId] = useState("");

  const [caption, setCaption] = useState("");
  const [uploading, setUploading] = useState(false);
  const [saving, setSaving] = useState(false);

  const canShow = open && !!taskId;

  const headerTitle = useMemo(
    () => (task?.title ? `Task: ${task.title}` : "Task"),
    [task?.title]
  );

  async function loadAll(id: string) {
    try {
      const r1 = await fetch(`/api/task?id=${id}`, { cache: "no-store" });
      const j1 = (await r1.json()) as ApiOk<TaskRow>;
      setTask(j1.data);

      setTitle(j1.data.title || "");
      setDescription(j1.data.description || "");
      setPriority(j1.data.priority);
      setStatus(j1.data.status);
      setAssignedUserId(j1.data.assigned_user_id || "");

      const r2 = await fetch(`/api/task-photos?taskId=${id}`, { cache: "no-store" });
      const j2 = (await r2.json()) as ApiOk<TaskPhoto[]>;
      setPhotos(j2.data || []);
    } catch (e: any) {
      setErr(e.message);
    }
  }

  useEffect(() => {
    if (canShow && taskId) loadAll(taskId);
  }, [canShow, taskId]);

  async function save() {
    if (!taskId || !isUuid(uploadedBy)) return;
    setSaving(true);
    try {
      await fetch("/api/tasks", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id: taskId,
          changed_by: uploadedBy,
          title,
          description: description || null,
          priority,
          status,
          assigned_user_id: assignedUserId || null,
        }),
      });
    } finally {
      setSaving(false);
    }
  }

  async function uploadPhoto(file: File) {
    if (!taskId) return;
    setUploading(true);
    try {
      const base64 = await fileToBase64(file);
      const r = await fetch("/api/task-photos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          task_id: taskId,
          uploaded_by: uploadedBy,
          file_name: file.name,
          caption: caption || null,
          base64,
        }),
      });
      const j = (await r.json()) as ApiOk<TaskPhoto>;
      setPhotos((p) => [j.data, ...p]);
      setCaption("");
    } finally {
      setUploading(false);
    }
  }

  if (!open) return null;

  return (
    <>
      {/* overlay */}
      <div
        onClick={onClose}
        style={{
          position: "fixed",
          inset: 0,
          background: "rgba(0,0,0,0.45)",
          zIndex: 9998,
        }}
      />

      {/* CARD */}
      <div
        style={{
          position: "fixed",
          top: 24,
          right: 24,
          bottom: 24,
          width: "min(560px, 96vw)",
          background: "linear-gradient(180deg, #ffffff, #f9fafb)",
          borderRadius: 18,
          boxShadow: "0 25px 60px rgba(0,0,0,0.35)",
          border: "1px solid rgba(0,0,0,0.08)",
          zIndex: 9999,
          display: "flex",
          flexDirection: "column",
          overflow: "hidden",
          color: "#111827",
        }}
      >
        {/* HEADER */}
        <div
          style={{
            padding: "14px 16px",
            borderBottom: "1px solid rgba(0,0,0,0.08)",
            fontWeight: 900,
            display: "flex",
            justifyContent: "space-between",
          }}
        >
          {headerTitle}
          <button onClick={onClose}>✕</button>
        </div>

        {/* BODY */}
        <div style={{ padding: 16, overflow: "auto", display: "grid", gap: 16 }}>
          {err && <div style={{ color: "#b91c1c" }}>{err}</div>}

          <label>
            Tytuł
            <input value={title} onChange={(e) => setTitle(e.target.value)} />
          </label>

          <label>
            Opis
            <textarea value={description} onChange={(e) => setDescription(e.target.value)} />
          </label>

          <label>
            assigned_user_id
            <input value={assignedUserId} onChange={(e) => setAssignedUserId(e.target.value)} />
          </label>

          <button onClick={save} disabled={saving}>
            {saving ? "Zapisuję…" : "Zapisz"}
          </button>

          <hr />

          <div>
            <b>Zdjęcia</b>
            <input value={caption} onChange={(e) => setCaption(e.target.value)} placeholder="Podpis" />
            <input
              type="file"
              accept="image/*"
              disabled={uploading}
              onChange={(e) => {
                const f = e.target.files?.[0];
                if (!f) return;
                e.currentTarget.value = "";
                uploadPhoto(f);
              }}
            />

            <div style={{ display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: 8, marginTop: 8 }}>
              {photos.map((p) => (
                <img key={p.id} src={p.url} style={{ width: "100%", borderRadius: 10 }} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </>
  );
}
