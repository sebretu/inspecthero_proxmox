                           Table "public.task_comments"
   Column   |           Type           | Collation | Nullable |      Default      
------------+--------------------------+-----------+----------+-------------------
 id         | uuid                     |           | not null | gen_random_uuid()
 task_id    | uuid                     |           | not null | 
 content    | text                     |           | not null | 
 author_id  | uuid                     |           | not null | 
 created_at | timestamp with time zone |           | not null | now()
 updated_at | timestamp with time zone |           | not null | now()
Indexes:
    "task_comments_pkey" PRIMARY KEY, btree (id)
    "idx_task_comments_created_at" btree (created_at)
    "idx_task_comments_task" btree (task_id, created_at DESC)
    "idx_task_comments_task_id" btree (task_id)
Foreign-key constraints:
    "task_comments_author_id_fkey" FOREIGN KEY (author_id) REFERENCES profiles(id) ON DELETE RESTRICT
    "task_comments_task_id_fkey" FOREIGN KEY (task_id) REFERENCES tasks(id) ON DELETE CASCADE
Policies:
    POLICY "Users can view comments on tasks they can access" FOR SELECT
      USING ((EXISTS ( SELECT 1
   FROM (tasks t
     LEFT JOIN profiles p ON ((p.id = auth.uid())))
  WHERE ((t.id = task_comments.task_id) AND ((t.created_by = auth.uid()) OR (t.assigned_user_id = auth.uid()) OR (t.assigned_company_id = p.company_id))))))
    POLICY "task_comments_insert" FOR INSERT
      WITH CHECK (((author_id = auth.uid()) AND (EXISTS ( SELECT 1
   FROM tasks t
  WHERE ((t.id = task_comments.task_id) AND is_project_member(t.project_id))))))
    POLICY "task_comments_select" FOR SELECT
      USING ((EXISTS ( SELECT 1
   FROM tasks t
  WHERE ((t.id = task_comments.task_id) AND is_project_member(t.project_id) AND (is_project_admin_or_mod(t.project_id) OR (t.assigned_user_id = auth.uid()) OR (t.assigned_company_id = current_company_id()) OR (t.created_by = auth.uid()))))))
    POLICY "task_comments_update_self" FOR UPDATE
      USING ((author_id = auth.uid()))
      WITH CHECK ((author_id = auth.uid()))
Triggers:
    trg_task_comments_updated_at BEFORE UPDATE ON task_comments FOR EACH ROW EXECUTE FUNCTION set_updated_at()
    trigger_update_task_comments_updated_at BEFORE UPDATE ON task_comments FOR EACH ROW EXECUTE FUNCTION update_task_comments_updated_at()

